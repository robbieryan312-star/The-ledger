# Copy to .env.local (gitignored) — never commit real API key values.
# SET/EMPTY status of each key is tracked in KEYS.md. Every variable listed here is
# referenced in code; every process.env.* in code must appear here (guard-enforced).

# ── CORE KEYS (required for the national profile pipeline) ─────────────────────
# FEC / api.data.gov — campaign finance:      https://api.data.gov/signup/
FEC_API_KEY=
# Congress.gov v3 — bills, votes, members:    https://api.congress.gov/sign-up/
CONGRESS_API_KEY=
# GovInfo — CREC floor statements (the "Said" pipeline): https://api.govinfo.gov/docs/
GOVINFO_API_KEY=
# api.data.gov shared key (fallback used by some clients; may equal FEC_API_KEY)
DATA_GOV_API_KEY=

# ── OPTIONAL SOURCE KEYS (feature-specific; honest-gap if EMPTY) ────────────────
# LegiScan — state legislation (Florida pilot):      https://legiscan.com/legiscan
LEGISCAN_API_KEY=
# CourtListener — FL court opinion detail (search is keyless; clusters/opinions need token):
#   https://www.courtlistener.com/help/api/rest/ → profile → API token
COURTLISTENER_API_KEY=
# OpenStates — state legislators (Florida pilot):    https://openstates.org/accounts/profile/
OPENSTATES_API_KEY=
# SAM.gov — federal contractors (Florida pilot; needs login.gov identity)
SAM_API_KEY=
# Census — demographics (works keyless at low volume): https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# NewsAPI — DEFERRED (426 plan restriction; RSS registry is the news path)
NEWSAPI_KEY=
# VoteSmart NPAT — DEFERRED (Ballotpedia + CREC substitute)
VOTESMART_API_KEY=
# Cursor agent automation (agent tooling only; never used by app code)
CURSOR_API_KEY=
# Render-integrity guard: set 1 when CI already started next on port 4112
RENDER_INTEGRITY_EXTERNAL_SERVER=
# BEA Data API — Regional Price Parities (optional; sample used when empty)
BEA_API_KEY=

# ── RATE / CONCURRENCY TUNING (safe defaults in code; override only if throttled) ─
# GovInfo requests/sec (default 8; signed-key limit is 10/s)
GOVINFO_MAX_RPS=
# Ballotpedia requests/sec (default 2)
BALLOTPEDIA_MAX_RPS=
# Congress.gov requests/sec (default in code)
CONGRESS_MAX_RPS=
# senate.gov requests/sec (default in code)
SENATE_MAX_RPS=
# Parallel members in topic sync (default in code)
TOPIC_SYNC_CONCURRENCY=
# Skip procedural CREC granules during sync (default on; set 0 to disable)
CREC_SKIP_PROCEDURAL=
# Comma-separated bioguideIds for audit scripts (ad hoc)
AUDIT_IDS=
